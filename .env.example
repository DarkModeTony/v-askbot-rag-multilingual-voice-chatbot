# Copy this file to .env and add your local API keys.
GROQ_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

PORT=8000
HOST=0.0.0.0
DEBUG=True

DEFAULT_LLM_MODEL=allam-2-7b
FALLBACK_LLM_MODEL=allam-2-7b
TEMPERATURE=0.0
MAX_TOKENS=48
MAX_ANSWER_CHARS=180
GROQ_TIMEOUT_SECONDS=0.16
STRICT_LATENCY_MODE=true
WEB_SEARCH_ENABLED=true
LATENCY_FIRST_MODE=true
DATASET_ONLY_MODE=false

SIMILARITY_THRESHOLD=0.35
MAX_RETRIEVAL_CHUNKS=4
GUARDRAIL_GROUNDEDNESS_THRESHOLD=0.55
TARGET_LATENCY_MS=200